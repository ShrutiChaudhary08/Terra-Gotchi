# ====================================================================
# TERRAGOTCHI ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git or version control.
# ====================================================================

# --------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never prefix with VITE_, Never expose to client)
# --------------------------------------------------------------------

# Google Gemini API Key (Multimodal AI Craving & Vision Analysis)
# Obtain from Google AI Studio: https://aistudio.google.com/
# Used exclusively server-side in /server/gemini.ts and serverless functions.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Service Role Key (Optional - for administrative server-side operations)
# Keep strictly secret on server. Never expose to client browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server-side Supabase URL & Anon Key (Fallback if VITE_ vars are not passed to server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --------------------------------------------------------------------
# 2. CLIENT-EXPOSED ENVIRONMENT VARIABLES (Safe public variables)
# --------------------------------------------------------------------

# Supabase Project URL (Publicly accessible URL for your Supabase backend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Publishable Key (Protected by Postgres Row Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# --------------------------------------------------------------------
PORT=3000
NODE_ENV=development
